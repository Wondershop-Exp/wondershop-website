# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# App
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000,https://wondershopexperiences.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@wondershopexperiences.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=contact@wondershopexperiences.com
EMAIL_TEAM=contact@wondershopexperiences.com

# WhatsApp Business API — direct Meta Cloud API (legacy, no longer used
# by leads.py, kept here only if you ever want to switch back)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token

# WhatsApp via AiSensy (what leads.py actually uses)
AISENSY_API_KEY=your-aisensy-api-key
AISENSY_CAMPAIGN_NAME=wondershop_new_lead

# Google Sheets
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Wondershop Contact
WS_PHONE_1=+919004435362
WS_PHONE_2=+919742240477

# Instagram feed — see routers/instagram.py for the one-time Meta setup
# steps. IG_ACCESS_TOKEN is only the initial seed (long-lived, 60-day)
# token; the backend refreshes and persists it automatically after that.
IG_USER_ID=your-instagram-business-account-id
IG_ACCESS_TOKEN=your-long-lived-instagram-access-token
